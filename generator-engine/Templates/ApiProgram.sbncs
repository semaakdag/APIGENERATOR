{{ if Profile.Framework.ProjectLayout == "single-api" }}using {{ SolutionName }}.Api.Data;
using {{ SolutionName }}.Api.Repositories;
{{ if Profile.Framework.UseServiceLayer }}using {{ SolutionName }}.Api.Services;
{{ end }}using Microsoft.EntityFrameworkCore;
{{ else }}{{ if Profile.Framework.UseControllers == false }}using {{ SolutionName }}.Api.Endpoints;
{{ end }}using {{ SolutionName }}.Application.Abstractions.Persistence;
using {{ SolutionName }}.Application.Services;
using {{ SolutionName }}.Infrastructure.Repositories;
{{ end }}{{ if Profile.Framework.UseWindowsAuthentication }}using Microsoft.AspNetCore.Authentication.Negotiate;
{{ end }}using Microsoft.OpenApi.Models;

var builder = WebApplication.CreateBuilder(args);

{{ if Profile.Framework.UseControllers }}builder.Services.AddControllers();
{{ end }}builder.Services.AddEndpointsApiExplorer();
{{ if Profile.Framework.UseSwagger }}builder.Services.AddSwaggerGen(options =>
{
    options.SwaggerDoc("v1", new OpenApiInfo
    {
        Title = "{{ SolutionName }} API",
        Version = "v1"
    });

    var xmlDocumentation = Path.Combine(AppContext.BaseDirectory, $"{typeof(Program).Assembly.GetName().Name}.xml");
    if (File.Exists(xmlDocumentation))
    {
        options.IncludeXmlComments(xmlDocumentation);
    }
});

{{ end }}{{ if Profile.Framework.ProjectLayout == "single-api" }}{{ if Profile.Framework.DatabaseProvider == "sqlserver" }}builder.Services.AddDbContext<AppDbContext>(options =>
    options.UseSqlServer(builder.Configuration.GetConnectionString("{{ ConnectionStringName }}")));

{{ else }}builder.Services.AddDbContext<AppDbContext>(options =>
    options.UseInMemoryDatabase("{{ SolutionName }}"));

{{ end }}{{ end }}// Authentication integration point: register schemes here and protect controllers with [Authorize].
{{ if Profile.Framework.UseWindowsAuthentication }}builder.Services.AddAuthentication(NegotiateDefaults.AuthenticationScheme)
    .AddNegotiate();
{{ end }}builder.Services.AddAuthorization();

{{ for entity in Entities }}{{ if Profile.Framework.UseServiceLayer }}builder.Services.AddScoped<{{ entity.ServiceInterfaceName }}, {{ entity.ServiceImplementationName }}>();
{{ end }}builder.Services.AddScoped<{{ entity.RepositoryInterfaceName }}, {{ entity.RepositoryImplementationName }}>();
{{ end }}
var app = builder.Build();

{{ if Profile.Framework.UseSwagger }}app.UseSwagger();
app.UseSwaggerUI();
{{ end }}app.UseHttpsRedirection();
{{ if Profile.Framework.UseWindowsAuthentication }}app.UseAuthentication();
{{ end }}app.UseAuthorization();
{{ if Profile.Framework.UseControllers }}app.MapControllers();
{{ else }}{{ for entity in Entities }}app.Map{{ entity.EntityName }}Endpoints();
{{ for method in entity.RecipeMethods }}app.Map{{ entity.EntityName }}{{ method }}Endpoint();
{{ end }}{{ end }}{{ end }}app.Run();
