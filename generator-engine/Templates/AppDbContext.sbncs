{{ for entity_namespace in Entities | array.map "EntityNamespace" | array.uniq }}using {{ entity_namespace }};
{{ end }}using Microsoft.EntityFrameworkCore;

namespace {{ ApiDataNamespace }};

public sealed class AppDbContext : DbContext
{
    public AppDbContext(DbContextOptions<AppDbContext> options)
        : base(options)
    {
    }

{{ for entity in Entities }}
    public DbSet<{{ entity.EntityTypeName }}> {{ entity.PluralName }} => Set<{{ entity.EntityTypeName }}>();
{{ end }}

{{ relational = Profile.Framework.DatabaseProvider == "sqlserver" }}    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
{{ for entity in Entities }}        modelBuilder.Entity<{{ entity.EntityTypeName }}>(builder =>
        {
{{ if relational }}            builder.ToTable("{{ entity.TableName }}"{{ if entity.SchemaName }}, "{{ entity.SchemaName }}"{{ end }});
{{ end }}            builder.HasKey({{ entity.KeyExpression }});
{{ for property in entity.Properties }}{{ if relational || property.IsRowVersion || property.IsKeyWithoutIdentity }}            builder.Property(item => item.{{ property.Name }}){{ if relational }}{{ if property.ColumnName != property.Name }}.HasColumnName("{{ property.ColumnName }}"){{ end }}.HasColumnType("{{ property.StoreType }}"){{ end }}{{ if property.IsRowVersion }}.IsRowVersion(){{ end }}{{ if property.IsKeyWithoutIdentity }}.ValueGeneratedNever(){{ end }};
{{ end }}{{ end }}        });
{{ end }}    }
}
