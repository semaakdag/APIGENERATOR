{{ if !Profile.Framework.UseServiceLayer }}using EntityModel = {{ EntityNamespace }}.{{ EntityTypeName }};
using {{ RepositoryInterfaceNamespace }};
{{ else }}using CreateRequestModel = {{ CreateRequestNamespace }}.{{ CreateRequestName }};
using UpdateRequestModel = {{ UpdateRequestNamespace }}.{{ UpdateRequestName }};
using ResponseModel = {{ ResponseNamespace }}.{{ ResponseName }};
using {{ ServiceInterfaceNamespace }};
{{ end }}{{ if Profile.Framework.UseWindowsAuthentication }}using Microsoft.AspNetCore.Authorization;
{{ end }}using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;

namespace {{ ControllerNamespace }};

{{ if Profile.Controller.UseApiControllerAttribute }}[ApiController]
{{ end }}{{ if Profile.Framework.UseWindowsAuthentication }}[Authorize]
{{ end }}[Route("{{ Profile.Controller.RouteTemplate }}")]
public sealed class {{ ControllerName }} : {{ Profile.Controller.BaseClass }}
{
{{ if !Profile.Framework.UseServiceLayer }}    private readonly {{ RepositoryInterfaceName }} repository;

    public {{ ControllerName }}({{ RepositoryInterfaceName }} repository)
    {
        this.repository = repository;
    }

    [HttpGet]
    [ProducesResponseType(typeof(IReadOnlyList<EntityModel>), StatusCodes.Status200OK)]
    public async Task<IActionResult> GetAll(CancellationToken cancellationToken)
    {
        var result = await repository.GetAllAsync(cancellationToken);
        return Ok(result);
    }

    [HttpGet("{id}")]
    [ProducesResponseType(typeof(EntityModel), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> GetById({{ PrimaryKeyType }} id, CancellationToken cancellationToken)
    {
        var result = await repository.GetByIdAsync(id, cancellationToken);
        return result is null ? NotFound() : Ok(result);
    }

    [HttpPost]
    [ProducesResponseType(typeof(EntityModel), StatusCodes.Status201Created)]
    public async Task<IActionResult> Create([FromBody] EntityModel request, CancellationToken cancellationToken)
    {
        var result = await repository.AddAsync(request, cancellationToken);
        return CreatedAtAction(nameof(GetById), new { id = result.{{ PrimaryKeyName }} }, result);
    }

    [HttpPut("{id}")]
    [ProducesResponseType(typeof(EntityModel), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Update({{ PrimaryKeyType }} id, [FromBody] EntityModel request, CancellationToken cancellationToken)
    {
        request.{{ PrimaryKeyName }} = id;
        var result = await repository.UpdateAsync(request, cancellationToken);
        return result is null ? NotFound() : Ok(result);
    }

    [HttpDelete("{id}")]
    [ProducesResponseType(StatusCodes.Status204NoContent)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Delete({{ PrimaryKeyType }} id, CancellationToken cancellationToken)
    {
        var deleted = await repository.DeleteAsync(id, cancellationToken);
        return deleted ? NoContent() : NotFound();
    }
{{ else }}    private readonly {{ ServiceInterfaceName }} service;

    public {{ ControllerName }}({{ ServiceInterfaceName }} service)
    {
        this.service = service;
    }

    [HttpGet]
    [ProducesResponseType(typeof(IReadOnlyList<ResponseModel>), StatusCodes.Status200OK)]
    public async Task<IActionResult> GetAll(CancellationToken cancellationToken)
    {
        var result = await service.GetAllAsync(cancellationToken);
        return Ok(result);
    }

    [HttpGet("{id}")]
    [ProducesResponseType(typeof(ResponseModel), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> GetById({{ PrimaryKeyType }} id, CancellationToken cancellationToken)
    {
        var result = await service.GetByIdAsync(id, cancellationToken);
        return result is null ? NotFound() : Ok(result);
    }

    [HttpPost]
    [ProducesResponseType(typeof(ResponseModel), StatusCodes.Status201Created)]
    public async Task<IActionResult> Create([FromBody] CreateRequestModel request, CancellationToken cancellationToken)
    {
        var result = await service.CreateAsync(request, cancellationToken);
        return CreatedAtAction(nameof(GetById), new { id = result.{{ PrimaryKeyName }} }, result);
    }

    [HttpPut("{id}")]
    [ProducesResponseType(typeof(ResponseModel), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Update({{ PrimaryKeyType }} id, [FromBody] UpdateRequestModel request, CancellationToken cancellationToken)
    {
        var result = await service.UpdateAsync(id, request, cancellationToken);
        return result is null ? NotFound() : Ok(result);
    }

    [HttpDelete("{id}")]
    [ProducesResponseType(StatusCodes.Status204NoContent)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Delete({{ PrimaryKeyType }} id, CancellationToken cancellationToken)
    {
        var deleted = await service.DeleteAsync(id, cancellationToken);
        return deleted ? NoContent() : NotFound();
    }
{{ end }}}
