using {{ CreateRequestNamespace }};
using {{ UpdateRequestNamespace }};
using {{ ServiceInterfaceNamespace }};

namespace {{ EndpointNamespace }};

public static class {{ EndpointModuleName }}
{
    public static RouteGroupBuilder Map{{ EntityName }}Endpoints(this IEndpointRouteBuilder app)
    {
        var group = app.MapGroup("/api/{{ EntityName }}")
            .WithTags("{{ EntityName }}");

        group.MapGet("/", async ({{ ServiceInterfaceName }} service, CancellationToken cancellationToken) =>
        {
            var result = await service.GetAllAsync(cancellationToken);
            return Results.Ok(result);
        });

        group.MapGet("/{{ KeyRouteTemplate }}", async ({{ KeyParameters }}, {{ ServiceInterfaceName }} service, CancellationToken cancellationToken) =>
        {
            var result = await service.GetByIdAsync({{ KeyArguments }}, cancellationToken);
            return result is null ? Results.NotFound() : Results.Ok(result);
        });

        group.MapPost("/", async ({{ CreateRequestName }} request, {{ ServiceInterfaceName }} service, CancellationToken cancellationToken) =>
        {
            var result = await service.CreateAsync(request, cancellationToken);
            return result is null
                ? Results.Conflict()
                : Results.Created($"/api/{{ EntityName }}/{{ for key in Keys }}{result.{{ key.PropertyName }}}{{ if !for.last }}/{{ end }}{{ end }}", result);
        });

        group.MapPut("/{{ KeyRouteTemplate }}", async ({{ KeyParameters }}, {{ UpdateRequestName }} request, {{ ServiceInterfaceName }} service, CancellationToken cancellationToken) =>
        {
            var result = await service.UpdateAsync({{ KeyArguments }}, request, cancellationToken);
            return result is null ? Results.NotFound() : Results.Ok(result);
        });

        group.MapDelete("/{{ KeyRouteTemplate }}", async ({{ KeyParameters }}, {{ ServiceInterfaceName }} service, CancellationToken cancellationToken) =>
        {
            var deleted = await service.DeleteAsync({{ KeyArguments }}, cancellationToken);
            return deleted ? Results.NoContent() : Results.NotFound();
        });

        return group;
    }
}
