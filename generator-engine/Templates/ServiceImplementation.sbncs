namespace {{ ServiceImplementationNamespace }};

public sealed class {{ ServiceImplementationName }} : {{ ServiceInterfaceName }}
{
    private readonly {{ RepositoryInterfaceName }} repository;

    public {{ ServiceImplementationName }}({{ RepositoryInterfaceName }} repository)
    {
        this.repository = repository;
    }

    public async Task<IReadOnlyList<ResponseModel>> GetAllAsync(CancellationToken cancellationToken = default)
    {
        var entities = await repository.GetAllAsync(cancellationToken);
        return entities.Select(Map).ToList();
    }

    public async Task<ResponseModel?> GetByIdAsync({{ KeyParameters }}, CancellationToken cancellationToken = default)
    {
        var entity = await repository.GetByIdAsync({{ KeyArguments }}, cancellationToken);
        return entity is null ? null : Map(entity);
    }

    public async Task<ResponseModel?> CreateAsync(CreateRequestModel request, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(request);
{{ if !HasGeneratedKey }}        if (await repository.GetByIdAsync({{ KeyArgumentsFromRequest }}, cancellationToken) is not null)
        {
            return null;
        }

{{ end }}        var entity = new EntityModel
        {
{{ for property in Properties }}{{ if !property.IsGenerated }}            {{ property.Name }} = request.{{ property.Name }},
{{ end }}{{ end }}        };

        var created = await repository.AddAsync(entity, cancellationToken);
        return Map(created);
    }

    public async Task<ResponseModel?> UpdateAsync({{ KeyParameters }}, UpdateRequestModel request, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(request);
        var existing = await repository.GetByIdAsync({{ KeyArguments }}, cancellationToken);
        if (existing is null)
        {
            return null;
        }

{{ for property in Properties }}{{ if property.IsPrimaryKey }}        existing.{{ property.Name }} = {{ property.KeyParameterName }};
{{ else }}        existing.{{ property.Name }} = request.{{ property.Name }};
{{ end }}{{ end }}
        var updated = await repository.UpdateAsync(existing, cancellationToken);
        return updated is null ? null : Map(updated);
    }

    public Task<bool> DeleteAsync({{ KeyParameters }}, CancellationToken cancellationToken = default) =>
        repository.DeleteAsync({{ KeyArguments }}, cancellationToken);

    private static ResponseModel Map(EntityModel entity) =>
        new()
        {
{{ for property in Properties }}            {{ property.Name }} = entity.{{ property.Name }},
{{ end }}        };
}
