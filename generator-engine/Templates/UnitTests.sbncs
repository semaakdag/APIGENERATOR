    }

{{ end }}    [Fact]
    public async Task Update_returns_not_found_when_missing()
    {
        repository.Setup(item => item.UpdateAsync(It.IsAny<EntityModel>(), It.IsAny<CancellationToken>())).ReturnsAsync((EntityModel?)null);

        var result = await CreateSubject().Update({{ KeyMissingArguments }}, SampleEntity(), CancellationToken.None);

