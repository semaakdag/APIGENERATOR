using FluentAssertions;
using Moq;
using Xunit;
using EntityModel = {{ EntityNamespace }}.{{ EntityTypeName }};
using RepositoryContract = {{ RepositoryInterfaceNamespace }}.{{ RepositoryInterfaceName }};
{{ if Profile.Framework.UseServiceLayer }}using CreateRequestModel = {{ CreateRequestNamespace }}.{{ CreateRequestName }};
using UpdateRequestModel = {{ UpdateRequestNamespace }}.{{ UpdateRequestName }};
using SubjectUnderTest = {{ ServiceImplementationNamespace }}.{{ ServiceImplementationName }};
{{ else }}using Microsoft.AspNetCore.Mvc;
using SubjectUnderTest = {{ ControllerNamespace }}.{{ ControllerName }};
